{
    "version": "2.0.0",
    "tasks": [
        // 清理 MathNote 下全部笔记的中间文件
        {
            "label": "Clean Auxiliary Files",
            "type": "process",
            "command": "find",
            "args": [
                ".", "-type", "f", "(",
                "-name", "*.aux", "-o",
                "-name", "*.bcf", "-o",
                "-name", "*.log", "-o",
                "-name", "*.out", "-o",
                "-name", "*.toc", "-o",
                "-name", "*.xml", "-o",
                "-name", "*.bbl", "-o",
                "-name", "*.blg", "-o",
                "-name", "*.fls", "-o",
                "-name", "*.xdv", "-o",
                "-name", "*.nav", "-o",
                "-name", "*.snm", "-o",
                "-name", "*.vrb", "-o",
                "-name", "*.synctex(busy)", "-o",
                "-name", "*.Identifier", "-o",
                "-name", "*.fdb_latexmk", "-o",
                "-name", "*.bbl-SAVE-ERROR", "-o",
                "-name", "*.bcf-SAVE-ERROR", "-o",
                "-name", "*.fdb-SAVE-ERROR",
                ")", "-delete"
            ],
            "options": { "cwd": "${workspaceFolder}/LaTeX Project/MathNote" },
            "problemMatcher": [],
            "group": "build"
        },

        // 逐个编译 MathNote 下所有 main.tex
        {
            "label": "Compile All Sub-documents",
            "type": "shell",
            "command": "find . -maxdepth 2 -type f -name main.tex -execdir sh -c 'latexmk -xelatex -synctex=1 -interaction=nonstopmode main.tex' {} \\;",
            "options": { "cwd": "${workspaceFolder}/LaTeX Project/MathNote" },
            "problemMatcher": [],
            "group": "build"
        },

        // 先清理，再逐个编译
        {
            "label": "Clean & Compile All Sub-documents",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Clean Auxiliary Files",
                "Compile All Sub-documents"
            ],
            "problemMatcher": []
        },

        // 只清理单篇笔记：运行时从下拉列表选一个文件夹
        // 新增笔记后，把文件夹名补进下方 inputs 的 options
        {
            "label": "Clean One Note's Aux Files",
            "type": "process",
            "command": "find",
            "args": [
                "./${input:noteFolder}", "-type", "f", "(",
                "-name", "*.aux", "-o",
                "-name", "*.bcf", "-o",
                "-name", "*.log", "-o",
                "-name", "*.out", "-o",
                "-name", "*.toc", "-o",
                "-name", "*.xml", "-o",
                "-name", "*.bbl", "-o",
                "-name", "*.blg", "-o",
                "-name", "*.fls", "-o",
                "-name", "*.xdv", "-o",
                "-name", "*.nav", "-o",
                "-name", "*.snm", "-o",
                "-name", "*.vrb", "-o",
                "-name", "*.synctex(busy)", "-o",
                "-name", "*.Identifier", "-o",
                "-name", "*.fdb_latexmk", "-o",
                "-name", "*.bbl-SAVE-ERROR", "-o",
                "-name", "*.bcf-SAVE-ERROR", "-o",
                "-name", "*.fdb-SAVE-ERROR",
                ")", "-delete"
            ],
            "options": { "cwd": "${workspaceFolder}/LaTeX Project/MathNote" },
            "problemMatcher": [],
            "group": "build"
        }
    ],

    "inputs": [
        {
            "id": "noteFolder",
            "type": "pickString",
            "description": "选择要清理中间文件的笔记文件夹",
            "options": [
                "Abstract Algebra",
                "Analytic Geometry",
                "Basis of Algebra",
                "Basis of Analytics",
                "Complex Analysis",
                "Deep Learning",
                "Differential Geometry",
                "Differential Manifold",
                "Draft",
                "Functional Analysis",
                "Harmonic Analysis",
                "Hyperbolic Conservation Laws in Continuum Physics",
                "Measure Theory and Fine Properties of Functions(Evans, Gariepy)",
                "Measure Theory and Nonlinear Evolution Equations",
                "Number Theory",
                "Numerical Analysis",
                "Partial Differential Equations",
                "Partial Differential Equations(Evans)",
                "Probability Theory",
                "Real Analysis",
                "Real Analysis(Royden)",
                "Set Theory",
                "Topology",
                "Topology(Munkres)"
            ]
        }
    ]
}
