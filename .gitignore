# ==================== Lean / Lake ====================
# 构建缓存与下载的依赖（体积最大，绝不上传）
.lake/

# 构建产物兜底（正常情况下都在 .lake 内）
*.olean
*.ilean
*.olean.hash
*.ilean.hash
*.trace

# ==================== LaTeX 中间文件 ====================
*.aux
*.bcf
*.blf
*.blg
*.bbl
*.bbl-SAVE-ERROR
*.bcf-SAVE-ERROR
*.fdb-SAVE-ERROR
*.fdb_latexmk
*.fls
*.gz
*.Identifier
*.log
*.nav
*.out
*.snm
*.synctex(busy)
*.cpt
*.toc
*.vrb
*.xdv
*.xml

# ==================== Python ====================
__pycache__/
*.pyc
.pylibs/

# ==================== 第三方 Lean 工程 ====================
# ==================== 系统 / 编辑器临时文件 ====================
.DS_Store
Thumbs.db
*.swp
*~

# ==================== VS Code ====================
# 保留共享配置，忽略个人化状态
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# 草稿区：需要排除上传就取消下面两行的注释
# Scratch/
# */Scratch/
